# Gemini API key (required for live LLM generation and embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Provider & model configuration (override freely without editing code)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
PROVIDER_TIMEOUT_SECONDS=60

# Persistence & storage paths (resolved relative to backend/)
DATABASE_URL=sqlite:///./data/documind.sqlite
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
