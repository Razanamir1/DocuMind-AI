# GEMINI_API_KEY: Required for Gemini AI API calls (Python FastAPI server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for CORS).
APP_URL="MY_APP_URL"

# LLM & Embedding model configuration (configurable without code edits)
LLM_PROVIDER="gemini"
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
PROVIDER_TIMEOUT_SECONDS="60"

# Python FastAPI backend port & optional explicit frontend API base URL
FASTAPI_PORT="8000"
VITE_API_BASE_URL=""

# Comma-separated allowed CORS origins for FastAPI
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
